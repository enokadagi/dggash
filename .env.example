# AWIK NET — Internet Service Provider
# Reference template for all environment variables.
# Copy to .env and fill in real values. NEVER commit .env files.

# ─────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────

# PostgreSQL connection string. Use the real host/db for the target environment.
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/awik_net?schema=public"

# JWT signing secrets — generate strong random values in production
JWT_SECRET="change-me-64-char-random-secret"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="change-me-another-64-char-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# 32-char encryption key for sensitive settings at rest
ENCRYPTION_KEY="a-32-char-long-encryption-key!!"

# ─────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────

NODE_ENV="development"
PORT=3001
# Public URL of the frontend
APP_URL="http://localhost:3000"
# Public URL of the API (used by the browser when NOT behind reverse proxy)
API_URL="http://localhost:3001"
# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS="http://localhost:3000"

# NEXT_PUBLIC_* are consumed by the Next.js web app at build time.
# Behind a reverse proxy use the public path, e.g. https://yourdomain.com
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="AWIK NET"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ─────────────────────────────────────────────────────────
# WHATSAPP (Meta WhatsApp Business Cloud API)
# ─────────────────────────────────────────────────────────

WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""

# ─────────────────────────────────────────────────────────
# SECURITY / RATE LIMITING
# ─────────────────────────────────────────────────────────

THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# ─────────────────────────────────────────────────────────
# BACKUPS
# ─────────────────────────────────────────────────────────

BACKUP_DIR="./backups"
BACKUP_RESTORE_TOKEN_TTL=300
# Optional S3-compatible backup destination (leave empty to disable)
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET=""

# ─────────────────────────────────────────────────────────
# MAINTENANCE
# ─────────────────────────────────────────────────────────

LOG_LEVEL="info"